# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security
SECRET_KEY=change-this-in-production-super-secret-key-32chars
OTP_EXPIRE_SECONDS=300
OTP_LENGTH=6
MAX_OTP_ATTEMPTS=5

# Database / Cache:
# Leave REDIS_URL empty or unset to automatically use local SQLite (zero-config, works everywhere)
# Or set to your Redis connection string: redis://localhost:6379/0
REDIS_URL=

# Email SMTP (Optional - if blank, OTP will be clearly printed in the server console for local testing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@oneid.local
